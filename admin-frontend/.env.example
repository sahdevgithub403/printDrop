# API Base URL for Shop Admin Frontend
# Production: absolute backend URL WITH /api suffix (Vercel static hosting has
# no backend proxy, so the app must call the API directly — a relative /api
# only works behind the Vite dev proxy or an Nginx reverse proxy).
# Example: VITE_API_BASE_URL=https://<your-backend>.up.railway.app/api
VITE_API_BASE_URL=https://YOUR_BACKEND_HOST/api

# Customer Portal Base URL (used for QR code poster generation & customer links)
# Must include scheme. Development: http://localhost:5173
# Production: https://YOUR_CUSTOMER_APP.vercel.app
VITE_CUSTOMER_APP_URL=https://YOUR_CUSTOMER_APP.vercel.app
