# PrintDrop customer app — LOCAL development template.
# Copy to .env.local (gitignored, never committed) and fill in local-only values.
# Production values are out of scope until deployment is approved.

# --- Server-only (never exposed to the browser) ---
# Isolated local test database (verified: printdrop_dev on localhost:5434).
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/printdrop_dev?schema=public
# Local HS256 secret (>= 32 chars). Generate locally, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_LOCAL_32PLUS_CHAR_SECRET
# Local document storage directory (development/test only; production
# refuses to serve files without R2 configuration — see phase report).
FILE_STORAGE_DIR=./uploads
# Password-reset mail: "true" enables the test outbox path, anything else
# (or unset) keeps the legacy disabled behavior (503 for existing accounts).
MAIL_ENABLED=false

# --- Public (safe for the browser) ---
# API origin served by this app.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
# Razorpay public key only — NEVER put the secret here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
