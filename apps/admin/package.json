{
  "name": "admin",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "tsc --noEmit",
    "electron:dev": "npm run dev",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@printdrop/db": "*",
    "@printdrop/domain": "*",
    "@stomp/stompjs": "^7.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "axios": "^1.20.0",
    "lucide-react": "^0.359.0",
    "mammoth": "^1.13.0",
    "material-symbols": "^0.48.0",
    "next": "^14.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.printalfa.admin",
    "productName": "PrintAlfa Admin",
    "directories": {
      "output": "dist-electron-build"
    },
    "files": [
      ".next/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/printalfa.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
